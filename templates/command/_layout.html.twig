{% extends 'base.html.twig' %}
{% block body %}
<div class="min-h-full flex flex-col">
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-20">
        <div class="max-w-screen-2xl mx-auto px-4 h-14 flex items-center justify-between gap-4">
            <a href="{{ path('command_dashboard') }}" class="flex items-center gap-2 font-semibold tracking-tight">
                <span>🛡️</span><span>Tarcza Command</span>
                <span class="ml-2 text-[10px] uppercase tracking-widest text-sky-400 border border-sky-500/40 rounded px-1.5 py-0.5">live</span>
            </a>
            <nav class="flex items-center gap-4 text-sm text-slate-300">
                <a href="{{ path('command_dashboard') }}" class="hover:text-white">Mapa</a>
                <a href="/api/doc" target="_blank" class="hover:text-white">API</a>
                <span class="text-slate-500">{{ app.user ? app.user.displayName : '' }}</span>
                <a href="{{ path('command_logout') }}" class="hover:text-white">Wyloguj</a>
            </nav>
        </div>
    </header>
    {% for message in app.flashes('success') %}
        <div class="bg-emerald-500/10 border-b border-emerald-500/40 text-emerald-200 text-sm px-4 py-2 text-center">{{ message }}</div>
    {% endfor %}
    <main class="flex-1">{% block main %}{% endblock %}</main>
</div>
{% endblock %}
