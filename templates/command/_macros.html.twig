<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}" aria-hidden="true">{{ paths[name]|default('')|raw }}</svg>
