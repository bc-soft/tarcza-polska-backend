{% macro level_color(level) -%}
{{- {'unverified': '#8A93A8', 'likely': '#F59E0B', 'high': '#EA580C', 'confirmed': '#1B4DB1'}[level]|default('#8A93A8') -}}
{%- endmacro %}

{% macro confidence_badge(level, label, score = null) -%}
{%- set styles = {
    'unverified': 'bg-neutral-200 text-neutral-700',
    'likely': 'bg-warn-soft text-warn',
    'high': 'bg-orange-100 text-orange-700',
    'confirmed': 'bg-tertiary text-white',
} -%}
<span class="badge {{ styles[level]|default(styles.unverified) }}">{{ label }}{% if score is not null %} · {{ (score * 100)|round }}%{% endif %}</span>
{%- endmacro %}

{% macro status_badge(status) -%}
{%- set map = {
    'detected': ['Wykryty', 'bg-neutral-200 text-neutral-700'],
    'verifying': ['Weryfikacja', 'bg-tertiary-soft text-tertiary'],
    'active': ['Aktywny', 'bg-primary-soft text-primary'],
    'resolved': ['Zamknięty', 'bg-ok-soft text-ok'],
} -%}
{%- set s = map[status]|default([status, 'bg-neutral-200 text-neutral-700']) -%}
<span class="badge {{ s[1] }}">{{ s[0] }}</span>
{%- endmacro %}

{% macro severity_badge(severity) -%}
{%- set map = {
    'info': ['Informacja', 'bg-tertiary-soft text-tertiary'],
    'warning': ['Ostrzeżenie', 'bg-warn-soft text-warn'],
    'danger': ['Zagrożenie', 'bg-primary text-white'],
} -%}
{%- set s = map[severity]|default([severity, 'bg-neutral-200 text-neutral-700']) -%}
<span class="badge {{ s[1] }}">{{ s[0] }}</span>
{%- endmacro %}

{% macro shelter_badge(status, label) -%}
{%- set map = {
    'open': 'bg-ok-soft text-ok',
    'closed': 'bg-primary-soft text-primary',
    'full': 'bg-warn-soft text-warn',
    'unknown': 'bg-neutral-200 text-neutral-700',
} -%}
<span class="badge {{ map[status]|default(map.unknown) }}">{{ label }}</span>
{%- endmacro %}

{% macro role_badge(role) -%}
{%- set map = {
    'ROLE_ADMIN': ['Administrator', 'bg-secondary text-white'],
    'ROLE_OPERATOR': ['Operator', 'bg-primary-soft text-primary'],
    'ROLE_ANALYST': ['Analityk', 'bg-tertiary-soft text-tertiary'],
} -%}
{%- set s = map[role]|default([role, 'bg-neutral-200 text-neutral-700']) -%}
<span class="badge {{ s[1] }}">{{ s[0] }}</span>
{%- endmacro %}

{# Horizontal progress bar in the style of the design system (red / navy / blue). #}
{% macro bar(value, color = 'primary', height = 'h-2') -%}
{%- set bg = {'primary': 'bg-primary', 'secondary': 'bg-secondary', 'tertiary': 'bg-tertiary', 'ok': 'bg-ok', 'warn': 'bg-warn'}[color]|default('bg-primary') -%}
<div class="w-full {{ height }} rounded-full bg-neutral-200/80 overflow-hidden"><div class="{{ height }} rounded-full {{ bg }} transition-all" style="width: {{ min((value|abs * 100)|round, 100) }}%"></div></div>
{%- endmacro %}

{% macro stat(label, value, id = null, hint = null) -%}
<div class="stat">
    <div class="eyebrow">{{ label }}</div>
    <div class="stat-value" {% if id %}id="{{ id }}"{% endif %}>{{ value }}</div>
    {% if hint %}<div class="text-xs text-neutral-500">{{ hint }}</div>{% endif %}
</div>
{%- endmacro %}

{% macro empty(text, icon = 'info') -%}
<div class="card-lite p-6 text-center text-sm text-neutral-500 flex flex-col items-center gap-2">
    {{ _self.icon(icon, 'w-6 h-6 text-neutral-400') }}
    <div>{{ text|raw }}</div>
</div>
{%- endmacro %}

{% macro ago(date) -%}
{%- set diff = date('now').timestamp - date.timestamp -%}
{%- if diff < 60 -%}przed chwilą
{%- elseif diff < 3600 -%}{{ (diff / 60)|round }} min temu
{%- elseif diff < 86400 -%}{{ (diff / 3600)|round }} godz. temu
{%- else -%}{{ date|date('d.m H:i') }}
{%- endif -%}
{%- endmacro %}
