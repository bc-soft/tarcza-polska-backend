{% extends 'command/_layout.html.twig' %}
{% block title %}{{ detail.typeLabel }} - Tarcza Command{% endblock %}
{% block main %}
{% set levelColor = {'unverified': '#64748b', 'likely': '#f59e0b', 'high': '#f97316', 'confirmed': '#ef4444'} %}
<div class="grid grid-cols-1 xl:grid-cols-[1fr_440px] h-[calc(100vh-3.5rem)]">
    <div class="relative">
        <div id="map" class="absolute inset-0"></div>
        <div class="absolute top-4 left-4 bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-xl max-w-sm">
            <div class="flex items-center gap-3">
                <span class="text-lg font-semibold">{{ detail.typeLabel }}</span>
                <span class="text-xs rounded-full px-2 py-0.5 border" style="border-color: {{ levelColor[detail.confidenceLevel] }}; color: {{ levelColor[detail.confidenceLevel] }}">{{ detail.confidenceLabel }}</span>
            </div>
            <div class="mt-2 flex items-end gap-2">
                <span id="score" class="text-4xl font-bold" style="color: {{ levelColor[detail.confidenceLevel] }}">{{ (detail.confidenceScore * 100)|round }}%</span>
                <span class="text-xs text-slate-400 mb-1">confidence</span>
            </div>
            <div class="mt-2 text-xs text-slate-400">{{ detail.status }} · ring {{ detail.currentRing }} · komórek {{ detail.cells.total }} (+{{ detail.cells.positive }} / −{{ detail.cells.negative }})</div>
            <div class="mt-3 grid grid-cols-3 gap-2 text-center text-xs">
                <div class="bg-slate-800 rounded p-2"><div class="text-slate-400">zgłoszeń</div><div class="text-base font-semibold">{{ detail.community.reports }}</div></div>
                <div class="bg-slate-800 rounded p-2"><div class="text-slate-400">TAK</div><div class="text-base font-semibold text-red-300">{{ detail.answers.yes }}</div></div>
                <div class="bg-slate-800 rounded p-2"><div class="text-slate-400">NIE</div><div class="text-base font-semibold text-emerald-300">{{ detail.answers.no }}</div></div>
            </div>
            <div class="mt-3 flex gap-3 text-[11px] text-slate-400">
                <span><i class="inline-block w-3 h-3 rounded-sm align-middle" style="background:#ef4444aa"></i> problem</span>
                <span><i class="inline-block w-3 h-3 rounded-sm align-middle" style="background:#22c55eaa"></i> brak problemu</span>
                <span><i class="inline-block w-3 h-3 rounded-sm align-middle" style="background:#64748b66"></i> pytamy</span>
            </div>
        </div>
    </div>

    <aside class="border-l border-slate-800 bg-slate-900/60 overflow-y-auto p-5 space-y-6 text-sm">
        {% if detail.summary %}
            <section>
                <h3 class="text-xs uppercase tracking-wide text-slate-400 mb-2">AI research</h3>
                <p class="text-slate-200 leading-relaxed">{{ detail.summary }}</p>
            </section>
        {% endif %}

        <section>
            <h3 class="text-xs uppercase tracking-wide text-slate-400 mb-2">Źródła zewnętrzne ({{ detail.sources|length }})</h3>
            {% for s in detail.sources %}
                <div class="border border-slate-800 rounded-lg p-3 mb-2">
                    <a href="{{ s.url }}" target="_blank" rel="noopener" class="font-medium hover:underline">{{ s.title }}</a>
                    <div class="text-xs text-slate-400 mt-1">{{ s.publisher ?? s.kind }} · wiarygodność {{ (s.credibility * 100)|round }}% · {{ s.foundBy }}</div>
                    {% if s.excerpt %}<div class="text-xs text-slate-300 mt-1">{{ s.excerpt }}</div>{% endif %}
                </div>
            {% else %}
                <div class="text-slate-500">Brak. {% if detail.researchedAt %}Research zakończony {{ detail.researchedAt|date('H:i') }} bez potwierdzeń.{% else %}Research uruchomi się po osiągnięciu poziomu „prawdopodobne”.{% endif %}</div>
            {% endfor %}
        </section>

        <section>
            <h3 class="text-xs uppercase tracking-wide text-slate-400 mb-2">Jak policzono confidence</h3>
            {% set c = detail.confidenceBreakdown.components ?? {} %}
            <div class="space-y-1">
                {% for name, value in c %}
                    <div class="flex items-center gap-2"><span class="w-24 text-slate-400">{{ name }}</span>
                        <div class="flex-1 h-2 bg-slate-800 rounded"><div class="h-2 rounded {{ value < 0 ? 'bg-emerald-500' : 'bg-sky-500' }}" style="width: {{ (value|abs * 100)|round }}%"></div></div>
                        <span class="w-14 text-right tabular-nums">{{ value|number_format(2) }}</span></div>
                {% endfor %}
            </div>
        </section>

        <section>
            <h3 class="text-xs uppercase tracking-wide text-slate-400 mb-2">Fale weryfikacji ({{ waves|length }}) · wysłano {{ detail.verification.sent }}, odpowiedzi {{ detail.verification.answered }}</h3>
            <ol class="space-y-1">
                {% for w in waves %}
                    <li class="flex justify-between text-xs"><span>ring {{ w.ring }} · {{ w.targetCells|length }} komórek · {{ w.requestsSent }} urządzeń</span><span class="text-slate-400">{{ w.startedAt|date('H:i:s') }} {{ w.closedAt ? '→ zamknięta' : '→ otwarta' }}</span></li>
                {% endfor %}
            </ol>
        </section>

        <section>
            <h3 class="text-xs uppercase tracking-wide text-slate-400 mb-2">Zgłoszenia ({{ detail.reports|length }})</h3>
            <ul class="space-y-1 max-h-48 overflow-y-auto">
                {% for r in detail.reports %}
                    <li class="text-xs text-slate-300">{{ r.createdAt|date('H:i:s') }} · {{ r.h3Cell }}{% if r.simulated %} · <span class="text-slate-500">sim</span>{% endif %}{% if r.description %} · „{{ r.description }}”{% endif %}</li>
                {% endfor %}
            </ul>
        </section>

        {% if is_granted('ROLE_OPERATOR') %}
        <section class="border-t border-slate-800 pt-5">
            <h3 class="text-xs uppercase tracking-wide text-slate-400 mb-2">Wyślij komunikat do obszaru</h3>
            {% if detail.area %}
            <form method="post" action="{{ path('command_incident_alert', {id: incident.id}) }}" class="space-y-2">
                <input type="hidden" name="_token" value="{{ csrf_token('alert' ~ incident.id) }}">
                <input name="title" required maxlength="160" value="Potwierdzono: {{ detail.typeLabel|lower }} w Twojej okolicy" class="w-full rounded bg-slate-800 border border-slate-700 px-3 py-2">
                <textarea name="body" required rows="3" class="w-full rounded bg-slate-800 border border-slate-700 px-3 py-2">Problem zgłasza {{ detail.community.agreementPct ?? '—' }}% odpowiadających użytkowników. Służby zostały poinformowane. Sprawdź najbliższy punkt pomocy w aplikacji.</textarea>
                <div class="flex gap-2">
                    <select name="severity" class="rounded bg-slate-800 border border-slate-700 px-2 py-2"><option value="info">info</option><option value="warning" selected>ostrzeżenie</option><option value="danger">zagrożenie</option></select>
                    <input name="ttlMinutes" type="number" min="5" max="1440" value="180" class="w-24 rounded bg-slate-800 border border-slate-700 px-2 py-2">
                    <button class="flex-1 rounded bg-sky-600 hover:bg-sky-500 px-3 py-2 font-medium">Wyślij</button>
                </div>
            </form>
            {% else %}
                <div class="text-slate-500">Obszar nie został jeszcze wyznaczony.</div>
            {% endif %}
        </section>
        {% endif %}
    </aside>
</div>
<script>
    const detail = {{ detail|json_encode|raw }};
    const stateColor = {positive: '#ef4444', negative: '#22c55e', unknown: '#64748b'};
    const map = new maplibregl.Map({container: 'map', style: 'https://tiles.openfreemap.org/styles/dark', center: detail.centroid.coordinates, zoom: 13.5});
    map.addControl(new maplibregl.NavigationControl());
    function colorize(fc) { fc.features.forEach(f => f.properties.color = stateColor[f.properties.state]); return fc; }
    map.on('load', () => {
        map.addSource('cells', {type: 'geojson', data: colorize(detail.cellsGeoJson)});
        map.addLayer({id: 'cells-fill', type: 'fill', source: 'cells', paint: {'fill-color': ['get', 'color'], 'fill-opacity': ['case', ['==', ['get', 'state'], 'unknown'], 0.25, 0.5]}});
        map.addLayer({id: 'cells-line', type: 'line', source: 'cells', paint: {'line-color': ['get', 'color'], 'line-width': 1}});
        map.addSource('area', {type: 'geojson', data: {type: 'Feature', geometry: detail.area ?? detail.centroid, properties: {}}});
        map.addLayer({id: 'area-line', type: 'line', source: 'area', filter: ['!=', '$type', 'Point'], paint: {'line-color': '#f8fafc', 'line-width': 2.5, 'line-dasharray': [2, 1]}});
        map.addSource('reports', {type: 'geojson', data: {type: 'FeatureCollection', features: detail.reports.map(r => ({type: 'Feature', geometry: r.location, properties: {}}))}});
        map.addLayer({id: 'reports', type: 'circle', source: 'reports', paint: {'circle-color': '#fbbf24', 'circle-radius': 4, 'circle-stroke-color': '#0f172a', 'circle-stroke-width': 1}});
        map.on('click', 'cells-fill', e => {
            const p = e.features[0].properties;
            new maplibregl.Popup().setLngLat(e.lngLat).setHTML(`<div style="color:#0f172a;font-size:12px"><b>${p.h3}</b><br>stan: ${p.state} · ring ${p.ring}<br>zgłoszeń ${p.reports} · TAK ${p.yes} · NIE ${p.no} · pytano ${p.asked}</div>`).addTo(map);
        });
    });
    const es = new EventSource({{ mercure('incidents/' ~ incident.id)|json_encode|raw }}, {withCredentials: true});
    es.onmessage = e => {
        const msg = JSON.parse(e.data);
        if (msg.event !== 'incident.updated') return;
        map.getSource('cells')?.setData(colorize(msg.cells));
        map.getSource('area')?.setData({type: 'Feature', geometry: msg.incident.area ?? detail.centroid, properties: {}});
        document.getElementById('score').textContent = Math.round(msg.incident.confidenceScore * 100) + '%';
        if (['research_completed', 'external_source', 'wave_closed'].includes(msg.reason)) setTimeout(() => window.location.reload(), 800);
    };
</script>
{% endblock %}
