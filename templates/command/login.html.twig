{% extends 'base.html.twig' %}
{% import 'command/_macros.html.twig' as ui %}
{% block title %}Logowanie - Tarcza Polska Command{% endblock %}
{% block body %}
<div class="min-h-full grid lg:grid-cols-2">
    <section class="hidden lg:flex flex-col justify-between p-12 bg-secondary text-white relative overflow-hidden">
        <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-primary/40 blur-3xl"></div>
        <div class="absolute -left-20 bottom-0 h-80 w-80 rounded-full bg-tertiary/40 blur-3xl"></div>
        <div class="relative flex items-center gap-3">
            <img src="{{ asset('images/tarcza-polska-logo.png') }}" alt="Tarcza Polska" class="h-11 w-11 rounded-2xl bg-white object-contain">
            <span class="font-bold text-lg tracking-tight">Tarcza Polska Command</span>
        </div>
        <div class="relative max-w-md">
            <div class="eyebrow text-white/60">Centrum zarządzania kryzysowego</div>
            <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight">Jedna mapa sytuacyjna dla służb i obywateli.</h1>
            <p class="mt-4 text-white/70 leading-relaxed">Zgłoszenia mieszkańców, aktywna weryfikacja w siatce H3, deterministyczny wskaźnik wiarygodności i komunikaty push do obszaru zdarzenia.</p>
            <div class="mt-8 flex gap-6 text-sm">
                <div><div class="text-2xl font-bold">H3 · 9</div><div class="text-white/60">siatka analityczna</div></div>
                <div><div class="text-2xl font-bold">SSE</div><div class="text-white/60">aktualizacje live</div></div>
                <div><div class="text-2xl font-bold">AI</div><div class="text-white/60">research źródeł</div></div>
            </div>
        </div>
        <div class="relative text-xs text-white/50">Tarcza Polska · panel operatora</div>
    </section>

    <section class="flex items-center justify-center p-6">
        <form method="post" class="w-full max-w-sm card p-8 space-y-5">
            <div>
                <img src="{{ asset('images/tarcza-polska-logo.png') }}" alt="Tarcza Polska" class="lg:hidden mb-4 h-11 w-11 rounded-2xl bg-white object-contain shadow-card">
                <h2 class="text-2xl font-bold tracking-tight">Zaloguj się</h2>
                <p class="text-neutral-500 text-sm mt-1">Panel Command Center · konta operatorów</p>
            </div>
            {% if error %}
                <div class="rounded-xl bg-primary-soft text-primary text-sm px-4 py-3 flex items-center gap-2">{{ ui.icon('info', 'w-4 h-4') }}{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <label class="block">
                <span class="label">E-mail</span>
                <input type="email" name="_username" value="{{ last_username }}" required autofocus autocomplete="email" class="field" placeholder="operator@tarcza.local">
            </label>
            <label class="block">
                <span class="label">Hasło</span>
                <input type="password" name="_password" required autocomplete="current-password" class="field" placeholder="••••••••">
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="btn-primary w-full">Zaloguj {{ ui.icon('chevron-right', 'w-4 h-4') }}</button>
            <p class="text-xs text-neutral-500 leading-relaxed">Konto demo: <code class="font-semibold">operator@tarcza.local</code> / <code class="font-semibold">tarcza-demo</code> (po <code>make seed</code>).</p>
        </form>
    </section>
</div>
{% endblock %}
