{% extends 'base.html.twig' %}
{% import 'command/_macros.html.twig' as ui %}
{% block title %}Logowanie - Tarcza Polska Command{% endblock %}
{% block body %}
<div class="min-h-full grid lg:grid-cols-2">
    <section class="hidden lg:flex flex-col justify-between px-14 py-12 relative overflow-hidden">
        <img src="{{ asset('images/tarcza-polska-mark.png') }}" alt="" class="pointer-events-none absolute -right-28 top-1/2 h-[560px] w-[560px] -translate-y-1/2 object-contain opacity-[0.07]">
        <div class="relative flex items-center gap-3 border-b border-neutral-200 pb-6">
            <img src="{{ asset('images/tarcza-polska-mark.png') }}" alt="" class="h-12 w-12 object-contain">
            <span class="font-display text-2xl font-extrabold uppercase tracking-wide">Tarcza Polska</span>
            <span class="ml-auto font-mono text-xs uppercase tracking-[0.16em] text-neutral-500">Command Center</span>
        </div>
        <div class="relative max-w-xl">
            <div class="kicker">Społecznościowy system odporności cywilnej</div>
            <h1 class="mt-6 text-[112px] font-extrabold leading-[0.85]">Tarcza<br>Polska<span class="text-primary">.</span></h1>
            <p class="mt-6 font-display text-4xl font-semibold normal-case tracking-normal">Siła jest w nas.</p>
            <p class="mt-5 max-w-md text-xl font-light leading-relaxed text-neutral-500">Lokalne sygnały. Wspólny obraz.<br>Realna odporność.</p>
            <div class="mt-10 flex gap-8 font-mono text-[13px] text-neutral-700">
                <span class="flex items-center gap-2">{{ ui.icon('users', 'w-4 h-4 text-primary') }}Społeczność</span>
                <span class="flex items-center gap-2">{{ ui.icon('target', 'w-4 h-4 text-primary') }}Technologia</span>
                <span class="flex items-center gap-2">{{ ui.icon('shield', 'w-4 h-4 text-primary') }}Bezpieczeństwo</span>
            </div>
        </div>
        <div class="relative flex justify-between border-t border-neutral-200 pt-6 font-mono text-xs uppercase tracking-[0.14em] text-neutral-500">
            <span>Odporność cywilna · wspólny obraz sytuacji</span>
            <span>Zgłoś / potwierdź / reaguj</span>
        </div>
    </section>

    <section class="flex items-center justify-center p-6">
        <form method="post" class="w-full max-w-sm card p-8 space-y-5">
            <div>
                <div class="lg:hidden mb-5 flex items-center gap-3"><img src="{{ asset('images/tarcza-polska-mark.png') }}" alt="" class="h-14 w-14 object-contain"><span class="font-display text-3xl font-extrabold uppercase tracking-wide">Tarcza Polska<span class="text-primary">.</span></span></div>
                <h2 class="text-3xl font-extrabold">Zaloguj się</h2>
                <p class="text-neutral-500 text-sm mt-1">Panel Command Center · konta operatorów</p>
            </div>
            {% if error %}
                <div class="rounded-xl bg-primary-soft text-primary text-sm px-4 py-3 flex items-center gap-2">{{ ui.icon('info', 'w-4 h-4') }}{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <label class="block">
                <span class="label">E-mail</span>
                <input type="email" name="_username" value="{{ last_username }}" required autofocus autocomplete="email" class="field" placeholder="operator@tarcza.local">
            </label>
            <label class="block">
                <span class="label">Hasło</span>
                <input type="password" name="_password" required autocomplete="current-password" class="field" placeholder="••••••••">
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="btn-primary w-full">Zaloguj {{ ui.icon('chevron-right', 'w-4 h-4') }}</button>
            <p class="text-xs text-neutral-500 leading-relaxed">Konto demo: <code class="font-semibold">operator@tarcza.local</code> / <code class="font-semibold">tarcza-demo</code> (po <code>make seed</code>).</p>
        </form>
    </section>
</div>
{% endblock %}
