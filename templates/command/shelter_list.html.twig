{% extends 'command/_layout.html.twig' %}
{% import 'command/_macros.html.twig' as ui %}
{% block title %}Schrony - Tarcza Polska Command{% endblock %}
{% block main %}
{% set canEdit = is_granted('ROLE_OPERATOR') %}
<div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <div class="eyebrow">Shelter</div>
            <h1 class="text-2xl font-bold tracking-tight">Schrony i punkty pomocy</h1>
        </div>
        <div class="flex gap-2">
            {% for s in statuses %}
                <div class="card px-4 py-2 flex items-center gap-2 text-sm">{{ ui.shelter_badge(s.value, s.label) }}<span class="font-bold tabular-nums">{{ counts[s.value]|default(0) }}</span></div>
            {% endfor %}
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_400px] gap-4">
        <div class="flex flex-col gap-4 min-w-0">
            <section class="card relative overflow-hidden h-[380px]">
                <div id="map" class="absolute inset-0 rounded-2xl"></div>
                {% if canEdit %}<div class="absolute top-3 left-3 rounded-full bg-surface-3/95 shadow-card px-3 py-2 text-[11px] font-semibold text-neutral-700">{{ ui.icon('target', 'w-3.5 h-3.5 inline text-primary') }} Kliknij na mapie, aby wstawić współrzędne do formularza</div>{% endif %}
            </section>

            <section class="card overflow-hidden">
                <table class="table">
                    <thead><tr><th>Schron</th><th>Status</th><th>Pojemność</th><th>Potwierdzenia</th><th>Źródło</th>{% if canEdit %}<th></th>{% endif %}</tr></thead>
                    <tbody>
                    {% for s in shelters %}
                        {% set sid = s.id.toRfc4122 %}
                        <tr>
                            <td><div class="font-semibold leading-snug">{{ s.name }}</div><div class="text-xs text-neutral-500">{{ s.address ?? '—' }} · <span class="font-mono">{{ s.location.lat|number_format(4) }}, {{ s.location.lng|number_format(4) }}</span></div></td>
                            <td>
                                {% if canEdit %}
                                <form method="post" action="{{ path('command_shelter_status', {id: sid}) }}" class="flex items-center gap-1">
                                    <input type="hidden" name="_token" value="{{ csrf_token('shelter_status' ~ sid) }}">
                                    <select name="status" class="field !py-1 !px-2 !text-xs !w-auto" onchange="this.form.submit()">
                                        {% for st in statuses %}<option value="{{ st.value }}" {{ s.status == st ? 'selected' }}>{{ st.label }}</option>{% endfor %}
                                    </select>
                                </form>
                                {% else %}{{ ui.shelter_badge(s.status.value, s.status.label) }}{% endif %}
                            </td>
                            <td class="tabular-nums">{{ s.capacity ?? '—' }}</td>
                            <td class="text-xs text-neutral-700 whitespace-nowrap">{{ s.confirmationCount }} obywateli{% if s.lastConfirmedAt %}<br><span class="text-neutral-500">ostatnio {{ ui.ago(s.lastConfirmedAt) }}</span>{% endif %}</td>
                            <td><span class="badge bg-neutral-200 text-neutral-700">{{ s.source }}</span></td>
                            {% if canEdit %}
                            <td class="text-right whitespace-nowrap">
                                <button type="button" class="icon-btn bg-tertiary text-white hover:bg-tertiary-hover !h-8 !w-8" title="Edytuj" onclick="editShelter({{ {id: sid, name: s.name, address: s.address, lat: s.location.lat, lng: s.location.lng, capacity: s.capacity}|json_encode|e('html_attr') }})">{{ ui.icon('pencil', 'w-3.5 h-3.5') }}</button>
                            </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="6">{{ ui.empty('Brak schronów. Uruchom <code>make seed</code> albo dodaj pierwszy ręcznie.', 'home') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>

        <aside class="flex flex-col gap-4">
            {% if canEdit %}
            <section class="card p-5" id="shelter-form-card">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-bold" id="form-title">Dodaj schron</h3>
                    <button type="button" id="form-reset" class="btn-ghost btn-sm hidden" onclick="resetForm()">{{ ui.icon('x', 'w-3.5 h-3.5') }}Anuluj edycję</button>
                </div>
                <form method="post" action="{{ path('command_shelter_create') }}" id="shelter-form" class="space-y-3">
                    <input type="hidden" name="_token" id="form-token" value="{{ csrf_token('shelter_create') }}" data-create="{{ csrf_token('shelter_create') }}">
                    <label class="block"><span class="label">Nazwa</span><input name="name" id="f-name" required maxlength="160" class="field" placeholder="Schron – Dworzec Główny"></label>
                    <label class="block"><span class="label">Adres</span><input name="address" id="f-address" maxlength="255" class="field" placeholder="ul. Dworcowa 2"></label>
                    <div class="grid grid-cols-2 gap-2">
                        <label class="block"><span class="label">Szerokość (lat)</span><input name="lat" id="f-lat" type="number" step="0.000001" required class="field" placeholder="52.4019"></label>
                        <label class="block"><span class="label">Długość (lng)</span><input name="lng" id="f-lng" type="number" step="0.000001" required class="field" placeholder="16.9114"></label>
                    </div>
                    <label class="block"><span class="label">Pojemność (osób)</span><input name="capacity" id="f-capacity" type="number" min="0" class="field" placeholder="800"></label>
                    <button class="btn-primary w-full" id="form-submit">{{ ui.icon('plus', 'w-4 h-4') }}Dodaj schron</button>
                </form>
            </section>
            {% endif %}

            <section class="card p-5">
                <h3 class="font-bold mb-3">Ostatnie potwierdzenia obywateli</h3>
                <ul class="space-y-2 text-sm">
                    {% for r in recentReports %}
                        <li class="card-lite p-3">
                            <div class="flex items-center justify-between gap-2">{{ ui.shelter_badge(r.status.value, r.status.label) }}<span class="text-[11px] text-neutral-500">{{ ui.ago(r.createdAt) }}</span></div>
                            <div class="mt-1 font-semibold leading-snug">{{ r.shelter.name }}</div>
                            {% if r.comment %}<div class="mt-1 text-xs text-neutral-700">„{{ r.comment }}”</div>{% endif %}
                        </li>
                    {% else %}
                        <li class="text-sm text-neutral-500">Brak potwierdzeń z aplikacji.</li>
                    {% endfor %}
                </ul>
            </section>
        </aside>
    </div>
</div>

<script>
    const features = {{ features|json_encode|raw }};
    const canEdit = {{ canEdit ? 'true' : 'false' }};
    const tokens = {{ canEdit ? shelters|map(s => csrf_token('shelter' ~ s.id.toRfc4122))|json_encode|raw : '[]' }};
    const ids = {{ shelters|map(s => s.id.toRfc4122)|json_encode|raw }};
    const map = window.TARCZA.autosize(new maplibregl.Map({container: 'map', style: window.TARCZA.mapStyle, center: [16.93, 52.41], zoom: 11.2, attributionControl: false}));
    map.addControl(new maplibregl.NavigationControl({showCompass: false}), 'bottom-right');
    map.addControl(new maplibregl.AttributionControl({compact: true}), 'bottom-right');
    let marker = null;
    map.on('load', () => {
        map.addSource('shelters', {type: 'geojson', data: {type: 'FeatureCollection', features}});
        map.addLayer({id: 'shelter-point', type: 'circle', source: 'shelters', paint: {
            'circle-color': ['match', ['get', 'status'], 'open', '#15803D', 'closed', '#D4213D', 'full', '#D97706', '#8A93A8'],
            'circle-radius': 7, 'circle-stroke-color': '#fff', 'circle-stroke-width': 2}});
        map.on('click', 'shelter-point', e => {
            const p = e.features[0].properties;
            new maplibregl.Popup({closeButton: false}).setLngLat(e.lngLat).setHTML(`<b>${p.name}</b><br>${p.address ?? ''}<br>${p.statusLabel} · pojemność ${p.capacity ?? '—'}`).addTo(map);
            e.originalEvent.cancelBubble = true;
        });
        if (features.length) {
            const b = features.reduce((bb, f) => bb.extend(f.geometry.coordinates), new maplibregl.LngLatBounds(features[0].geometry.coordinates, features[0].geometry.coordinates));
            map.fitBounds(b, {padding: 60, maxZoom: 13});
        }
        if (canEdit) map.on('click', e => {
            if (e.originalEvent.cancelBubble) return;
            document.getElementById('f-lat').value = e.lngLat.lat.toFixed(6);
            document.getElementById('f-lng').value = e.lngLat.lng.toFixed(6);
            (marker ??= new maplibregl.Marker({color: '#D4213D'})).setLngLat(e.lngLat).addTo(map);
        });
    });
    function editShelter(s) {
        const form = document.getElementById('shelter-form');
        form.action = `/command/shelters/${s.id}`;
        document.getElementById('form-token').value = tokens[ids.indexOf(s.id)];
        document.getElementById('form-title').textContent = 'Edytuj schron';
        document.getElementById('form-submit').innerHTML = 'Zapisz zmiany';
        document.getElementById('form-reset').classList.remove('hidden');
        document.getElementById('f-name').value = s.name; document.getElementById('f-address').value = s.address ?? '';
        document.getElementById('f-lat').value = s.lat; document.getElementById('f-lng').value = s.lng; document.getElementById('f-capacity').value = s.capacity ?? '';
        (marker ??= new maplibregl.Marker({color: '#D4213D'})).setLngLat([s.lng, s.lat]).addTo(map);
        document.getElementById('shelter-form-card').scrollIntoView({behavior: 'smooth', block: 'start'});
    }
    function resetForm() {
        const form = document.getElementById('shelter-form');
        form.reset(); form.action = '{{ path('command_shelter_create') }}';
        document.getElementById('form-token').value = document.getElementById('form-token').dataset.create;
        document.getElementById('form-title').textContent = 'Dodaj schron';
        document.getElementById('form-submit').innerHTML = 'Dodaj schron';
        document.getElementById('form-reset').classList.add('hidden');
        marker?.remove(); marker = null;
    }
</script>
{% endblock %}
